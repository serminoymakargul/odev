from PIL import Image, ImageSequence

# 1. Mevcut kaydedilen GIF dosyasını açıyoruz
orijinal_gif = '/content/ajan_stok_erime_canli.gif'
img = Image.open(orijinal_gif)

# 2. Tüm kareleri tek tek hafızaya kopyalıyoruz
kareler = [kare.copy() for kare in ImageSequence.Iterator(img)]

# 3. GİTHUB ÖNBELLEĞİNİ KIRMAK İÇİN YENİ BİR İSİMLE KAYDEDİYORUZ
# loop=0 parametresi tarayıcılara "asla durma, sonsuz kez oynat" emri verir.
yeni_gif_yolu = '/content/depo_otonom_rl.gif'
kareler[0].save(yeni_gif_yolu, 
               save_all=True, 
               append_images=kareler[1:], 
               loop=0,         # KRİTİK AYAR: 0 = Sonsuz döngü
               duration=350)   # Kareler arası hız (milisaniye)

print(f"[BAŞARILI] GitHub uyumlu kesintisiz GIF oluşturuldu: {yeni_gif_yolu}")
print("Sol menüden 'depo_otonom_rl.gif' dosyasını bilgisayarınıza indirebilirsiniz.")
